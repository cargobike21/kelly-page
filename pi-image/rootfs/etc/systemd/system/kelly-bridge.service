[Unit]
Description=Kelly Page (the page on :8025; the radio lead, LoRa node and Bluetooth whenever they're there)
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
# + = as root: makes this Pi's own bridge token the first time (never baked into the image)
ExecStartPre=+/usr/local/lib/kellypage/kellypage-token
# --bind / --port here so kelly_bridge.py --connect-qr finds them
ExecStart=/usr/local/lib/kellypage/kellypage-run --bind 0.0.0.0 --port 8025
User=kellypage
Group=kellypage
SupplementaryGroups=dialout bluetooth
WorkingDirectory=/var/lib/kellypage
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
